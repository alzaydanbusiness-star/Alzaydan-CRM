{
  "name": "al-zaydan-crm-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "d1:migrate:local": "wrangler d1 execute al-zaydan-crm-db --local --file=./src/db/schema.sql",
    "d1:migrate:remote": "wrangler d1 execute al-zaydan-crm-db --remote --file=./src/db/schema.sql"
  },
  "dependencies": {
    "hono": "^4.7.4"
  },
  "devDependencies": {
    "wrangler": "^3.114.0"
  }
}
